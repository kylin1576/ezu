<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ezu</groupId>
        <artifactId>ezu</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ezu-admin</artifactId>
    <name>ezu-admin</name>
    <description>B端账号/RBAC/操作日志</description>

    <dependencies>
        <dependency>
            <groupId>com.ezu</groupId>
            <artifactId>ezu-common</artifactId>
        </dependency>
        <!-- BCrypt 密码加密（无传递依赖） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- 操作日志 AOP：Boot 4 已移除 spring-boot-starter-aop，直接依赖 BOM 管理的 aspectjweaver 即可启用 @Aspect 自动代理 -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>
        <!-- MP 3.5.9+ 分页插件拆分到独立工件（starter 仅 optional 引入），启用分页需显式依赖 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
